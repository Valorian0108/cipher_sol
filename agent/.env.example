# Copy to .env and fill in. Never commit .env.
# RPC endpoint, devnet.
RPC_URL=https://api.devnet.solana.com
# The deployed policy program address.
PROGRAM_ID=
# Keypairs. Either a JSON byte array as printed by solana-keygen, or a
# base58-encoded secret key. Generated locally, held only in this file.
OWNER_KEY=
AGENT_KEY=
VENDOR1_KEY=
VENDOR2_KEY=
VENDOR_ROGUE_KEY=
# Demo dollar rate used only for display. Not a market price.
DEMO_USD_PER_SOL=200
